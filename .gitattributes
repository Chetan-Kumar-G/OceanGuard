# Normalize line endings on checkin, auto-detect text files
* text=auto eol=lf

# Explicitly declare shell scripts as LF
*.sh text eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat these as binary (no diff, no EOL conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
